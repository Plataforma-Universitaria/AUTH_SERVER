# Configurações do Servidor de Autenticação (Auth Server)

# A porta está definida diretamente como 9090 em application.properties.

# URLs da plataforma PIPA
# Se rodando localmente, a porta padrão do PIPA Core é 8081
ROOT_URL_AUTH=http://localhost:8081/api/organization/authenticate-user
ROOT_URL_LOGOUT=http://localhost:8081/api/organization/logout
ROOT_URL_INSTITUTIONS=http://localhost:8081/api/organization/institutions
ROOT_URL_SALUTATION=http://localhost:8081/api/organization/login-fields/

# Configurações de Segurança (JWT)
# PRIVATE_KEY deve ser uma chave RSA em formato PEM (Base64)
PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Tempo de expiração em segundos (ex: 3600 = 1 hora)
EXP_TIME=3600
# Emissor do token (ex: sabia-auth-server)
ISSUER=sabia-auth-server

# URL de callback para onde o bot deve ser redirecionado (opcional se não usar Telegram)
CALLBACK=http://localhost:3000/auth/callback

# Chave com pelo menos 32 caracteres para /token e /logout; vazia desabilita acesso.
AUTH_MANAGEMENT_KEY=
